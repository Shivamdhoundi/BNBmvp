# StayPilot environment template
# Copy this file to .env.local and fill in the values from your Supabase project.
#   cp .env.example .env.local
#
# In Vercel, add the same variables under:
#   Project Settings -> Environment Variables (scope: Production, Preview, Development)

# --- Required (public, read by the browser and server) -------------------
# Supabase -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API -> Publishable key
# (For older Supabase projects, the legacy "anon" key works as the publishable key.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Recommended ---------------------------------------------------------
# Public base URL of the app. Used for OAuth and email confirmation redirects.
# Local:      http://localhost:3000
# Production: https://staypilot-alpha.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ---------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Used only by Drizzle migration commands. Never exposed to the browser.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase -> Project Settings -> API -> service_role key.
# Only needed for admin scripts such as test-db.ts. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
