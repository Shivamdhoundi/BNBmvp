# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical application origin used for auth email callbacks (HTTPS outside local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > Database > Connection string (server-only)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase Project Settings > API > service_role key (SERVER-ONLY, never NEXT_PUBLIC)
# Required for admin invitation and team identity operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# High-entropy secret for the protected /api/health endpoint (server-only).
HEALTHCHECK_SECRET=replace-with-a-long-random-secret

# Used by later automated jobs. Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-secret
