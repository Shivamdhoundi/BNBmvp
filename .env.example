# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical application origin used for auth email callbacks (HTTPS outside local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings > Database > Connection string (server-only)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase Project Settings > API > service_role key (SERVER-ONLY, never NEXT_PUBLIC)
# Required for invitations, team identity operations and shared auth/API rate limits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# High-entropy secret for the protected /api/health endpoint (server-only).
HEALTHCHECK_SECRET=replace-with-a-long-random-secret

# Optional MFA rollout deadline (ISO 8601). Before this date, privileged users
# without a verified factor are allowed through so administrators can stage a
# safe rollout. Unset also leaves enrollment optional. Sessions belonging to a
# user who already enrolled a factor must still verify at AAL2.
MFA_ENFORCEMENT_DATE=

# Production also requires migration 0010 and private.security_settings
# require_admin_mfa=true after privileged users enroll. See docs/production-readiness.md.
