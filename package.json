{
  "name": "staypilot-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "seed": "node scripts/seed-demo.mjs",
    "seed:clear": "node scripts/clear-demo.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:db": "node tests/database/run.mjs && DB_TEST_DEFAULT_GRANTS=legacy node tests/database/run.mjs",
    "test:e2e": "node scripts/test-browser.mjs",
    "check:production": "node scripts/production-preflight.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run db:check && npm audit --omit=dev && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "cookies": "^0.9.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
